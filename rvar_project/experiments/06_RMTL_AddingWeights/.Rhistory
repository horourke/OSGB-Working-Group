n <- 1000
p <- 20
q <- 3
bmin  <- 5
bmax  <- 10
prob <- 0.1
X <- matrix(rnorm(n * p), ncol = p)
signs <- c(-1, 1, 0)
Beta <- matrix(runif(p * q, bmin, bmax) *
sample(signs,
size = p * q,
replace = TRUE,
prob = c(prob/2, prob/2, 1 - prob)),
ncol = q)
E <- matrix(rnorm(n * q, sd =  0.2), ncol = q)
Y <- X %*% Beta + E
plot(Beta, border = NA, breaks = 20)
glmnet_fit <- glmnet(x = X, y = Y, family = "mgaussian")
