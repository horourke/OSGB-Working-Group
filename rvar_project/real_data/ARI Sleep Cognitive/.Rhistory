View(con)
view(con$response)
table(con$`response`)
table(con$`Response`)
conf_levels <- c(
"Definitely No",
"Probably No",
"Maybe No",
"Maybe Yes",
"Probably Yes",
"Definitely Yes"
)
con <- con %>%
mutate(
Response = factor(Response, levels = conf_levels, ordered = TRUE),
is_old = Old? == "old")
con <- con %>%
mutate(
Response = factor(Response, levels = conf_levels, ordered = TRUE),
is_old = `Old?` == "old"
)
View(con)
con <- con %>% filter(Response %in% conf_levels)
View(con)
roc_counts <- con %>%
group_by(`Participant ID`, `VDR?`, List, Response) %>%
summarise(
n = n(),
hits = sum(is_old),
fas  = sum(!is_old),
.groups = "drop"
)
View(roc_counts)
roc_rates <- roc_counts %>%
arrange(`Participant ID`, `VDR?`, List, desc(Response)) %>%
group_by(`Participant ID`, `VDR?`, List) %>%
mutate(
cum_hits = cumsum(hits),
cum_fas  = cumsum(fas),
n_old = sum(hits),
n_new = sum(fas),
hit_rate = cum_hits / n_old,
fa_rate  = cum_fas  / n_new
) %>%
ungroup()
View(roc_rates)
roc_rates <- roc_rates %>%
mutate(
hit_rate_adj = (cum_hits + 0.5) / (n_old + 1),
fa_rate_adj  = (cum_fas  + 0.5) / (n_new + 1)
)
roc_sdt <- roc_rates %>%
mutate(
d_prime = qnorm(hit_rate_adj) - qnorm(fa_rate_adj)
)
View(roc_sdt)
roc_sdt_avg <- roc_sdt %>%
group_by(`Participant ID`, `VDR?`, List) %>%
summarise(
d_prime = mean(d_prime, na.rm = TRUE),
.groups = "drop"
)
View(roc_sdt_avg)
roc_sdt_participant <- roc_sdt_avg %>%
group_by(`Participant ID`, `VDR?`) %>%
summarise(
d_prime = mean(d_prime, na.rm = TRUE),
.groups = "drop"
)
roc_wide <- roc_sdt_participant %>%
tidyr::pivot_wider(
names_from = `VDR?`,
values_from = d_prime
)
t.test(
roc_wide$VDR,
roc_wide$control,
paired = TRUE
)
