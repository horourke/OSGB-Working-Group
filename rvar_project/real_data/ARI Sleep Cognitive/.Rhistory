old_new_vdr <- old_new %>%
group_by(`Participant ID`, `VDR?`, List) %>%
summarise(
n_old_high = sum(`Old?` == "old" & Value == 10, na.rm = TRUE),
n_old_low = sum(`Old?` == "old" & Value ==1, na.rm = TRUE),
n_new = sum(`Old?` == "new", na.rm = TRUE),
hits = sum(Hit, na.rm = TRUE),
false_alarms = sum(FA, na.rm = TRUE),
hit_rate = (hits + .5) / (n_old + 1),
fa_rate = (false_alarms + .5) / (n_new + 1),
.groups = "drop"
)
old_new_vdr <- old_new %>%
group_by(`Participant ID`, `VDR?`, List) %>%
summarise(
n_old_high = sum(`Old?` == "old" & Value == 10, na.rm = TRUE),
n_old_low = sum(`Old?` == "old" & Value ==1, na.rm = TRUE),
n_new = sum(`Old?` == "new", na.rm = TRUE),
high_hits = sum(Hit & Value == 10, na.rm = TRUE),
low_hits = sum(Hit & Value == 1, na.rm = TRUE),
false_alarms = sum(FA, na.rm = TRUE),
high_hit_rate = (high_hits + .5) / (n_old_high + 1),
low_hit_rate = (low_hits + .5) / (n_old_low + 1),
fa_rate = (false_alarms + .5) / (n_new + 1),
.groups = "drop"
)
View(old_new_vdr)
old_new_vdr_rates <- old_new_vdr %>%
mutate(
high_d_prime = qnorm(high_hit_rate) - qnorm(fa_rate),
low_d_prime = qnorm(low_hit_rate) - qnorm(fa_rate),
c = -0.5 * (qnorm(hit_rate) + qnorm(fa_rate))
)
old_new_vdr_rates <- old_new_vdr %>%
old_new_vdr_rates <- old_new_vdr %>%
old_new_vdr_rates <- old_new_vdr %>%
high_d_prime = qnorm(high_hit_rate) - qnorm(fa_rate),
old_new_vdr_rates <- old_new_vdr %>%
mutate(
high_d_prime = qnorm(high_hit_rate) - qnorm(fa_rate),
low_d_prime = qnorm(low_hit_rate) - qnorm(fa_rate),
high_c = -0.5 * (qnorm(high_hit_rate) + qnorm(fa_rate)),
low_c = -0.5 * (qnorm(low_hit_rate) + qnorm(fa_rate))
)
View(old_new_vdr_rates)
old_new_vdr_rates_avg <- old_new_vdr_rates %>%
group_by(`Participant ID`, `VDR?`) %>%
summarise(
high_d_prime = mean(high_d_prime, na.rm = TRUE),
low_d_prime = mean(low_d_prime, na.rm = TRUE),
high_c = mean(high_c, na.rm = TRUE),
low_c = mean(low_c, na.rm = TRUE),
.groups = "drop"
)
View(old_new_vdr_rates_avg)
vdr_on_wide <- old_new_vdr_rates_avg %>%
